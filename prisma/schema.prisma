generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model FriendRequest {
  id         String              @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  receiver   User                @relation("receivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("friend_requests")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model User {
  id                        String               @id @default(cuid())
  email                     String               @unique
  emailVerified             DateTime?
  username                  String               @unique
  passwordHash              String?
  role                      Role                 @default(USER)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  lastActiveAt              DateTime?
  lastViolationAt           DateTime?
  violationCount            Int                  @default(0)
  status                    AccountStatus        @default(ACTIVE)
  suspendedUntil            DateTime?
  suspensionNote            String?
  suspensionReason          SuspensionReason?
  scheduledDeleteAt         DateTime?
  accounts                  Account[]
  aiConversations           AiConversation[]
  aiSavedPrompts            AiSavedPrompt[]
  blockedByUsers            Block[]              @relation("blocked")
  blockedUsers              Block[]              @relation("blocker")
  comments                  Comment[]
  ownedCommunities          Community[]          @relation("owner")
  memberships               CommunityMember[]
  conversations             ConversationMember[]
  documents                 Document[]
  following                 Follow[]             @relation("follower")
  followers                 Follow[]             @relation("following")
  receivedRequests          FriendRequest[]      @relation("receivedRequests")
  sentRequests              FriendRequest[]      @relation("sentRequests")
  createdInviteLinks        GroupInviteLink[]    @relation("inviteLinkCreator")
  likes                     Like[]
  messageReactions          MessageReaction[]
  pinnedMessages            Message[]            @relation("pinnedMessages")
  sentMessages              Message[]            @relation("sender")
  moderationActionsTaken    ModerationAction[]   @relation("moderationActor")
  moderationActionsReceived ModerationAction[]   @relation("moderationTarget")
  triggeredNotifs           Notification[]       @relation("actor")
  notifications             Notification[]       @relation("recipient")
  posts                     Post[]
  profile                   Profile?
  reportedPosts             Report[]             @relation("reportedUser")
  reports                   Report[]             @relation("reporter")
  resolvedReports           Report[]             @relation("reportResolver")
  savedDocuments            SavedDocument[]
  saves                     Save[]
  sessions                  Session[]
  supportRequests           SupportRequest[]

  @@map("users")
}

model Profile {
  id                      String                  @id @default(cuid())
  userId                  String                  @unique
  displayName             String?
  bio                     String?
  avatarUrl               String?
  coverUrl                String?
  school                  String?
  major                   String?
  grade                   String?
  website                 String?
  location                String?
  updatedAt               DateTime                @updatedAt
  showActivityStatus      Boolean                 @default(true)
  friendRequestPermission FriendRequestPermission @default(EVERYONE)
  messageFromFriendsOnly  Boolean                 @default(false)
  showFriendsList         Boolean                 @default(true)
  theme                   Theme                   @default(SYSTEM)
  language                Language                @default(VI)
  aiSettings              Json?
  aiMemory                String?
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model SupportRequest {
  id                String                @id @default(cuid())
  userId            String?
  subject           String
  message           String
  status            SupportRequestStatus  @default(PENDING)
  createdAt         DateTime              @default(now())
  resolvedAt        DateTime?
  type              SupportRequestType    @default(ACCOUNT_SUPPORT)
  code              String                @unique
  contactEmail      String
  guestName         String?
  ipHash            String?
  trackingTokenHash String?               @unique
  updatedAt         DateTime              @updatedAt
  replies           SupportRequestReply[]
  user              User?                 @relation(fields: [userId], references: [id])

  @@index([contactEmail])
  @@index([status])
  @@index([createdAt])
  @@index([ipHash])
  @@map("support_requests")
}

model SupportRequestReply {
  id               String               @id @default(cuid())
  supportRequestId String
  adminId          String?
  message          String
  statusAtReply    SupportRequestStatus
  createdAt        DateTime             @default(now())
  supportRequest   SupportRequest       @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@map("support_request_replies")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Post {
  id                String         @id @default(cuid())
  authorId          String
  title             String?
  content           String
  visibility        PostVisibility @default(PUBLIC)
  categoryId        String?
  communityId       String?
  likeCount         Int            @default(0)
  commentCount      Int            @default(0)
  saveCount         Int            @default(0)
  viewCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  editedAt          DateTime?
  hidden            Boolean        @default(false)
  scheduledDeleteAt DateTime?
  comments          Comment[]
  documents         Document[]
  likes             Like[]
  author            User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category          Category?      @relation(fields: [categoryId], references: [id])
  community         Community?     @relation(fields: [communityId], references: [id])
  reports           Report[]
  saves             Save[]
  tags              TagsOnPosts[]

  @@map("posts")
}

model Document {
  id                String              @id @default(cuid())
  uploaderId        String
  postId            String?
  title             String
  description       String?
  fileUrl           String
  fileKey           String
  fileSize          Int
  mimeType          String
  type              DocumentType
  pageCount         Int?
  extractedText     String?
  downloadCount     Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  grade             String?
  level             String?
  major             String?
  subject           String?
  subjectId         String?
  tags              String[]
  hidden            Boolean             @default(false)
  scheduledDeleteAt DateTime?
  aiSummaries       AiDocumentSummary[]
  post              Post?               @relation(fields: [postId], references: [id])
  uploader          User                @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  reports           Report[]
  savedBy           SavedDocument[]

  @@map("documents")
}

model SavedDocument {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("saved_documents")
}

model Comment {
  id             String    @id @default(cuid())
  postId         String
  authorId       String
  content        String
  parentId       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  fileName       String?
  fileSize       String?
  fileType       String?
  fileUrl        String?
  imageUrl       String?
  videoUrl       String?
  hidden         Boolean   @default(false)
  editedAt       DateTime?
  hiddenByAuthor String?
  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[] @relation("replies")
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  likes          Like[]
  reports        Report[]

  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("saves")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Conversation {
  id                String               @id @default(cuid())
  isGroup           Boolean              @default(false)
  name              String?
  avatarUrl         String?
  lastMessageAt     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  avatarKey         String?
  dmKey             String?              @unique
  disabledAt        DateTime?
  isDisabled        Boolean              @default(false)
  leaderBanDeadline DateTime?
  members           ConversationMember[]
  inviteLink        GroupInviteLink?
  messages          Message[]
  moderationActions ModerationAction[]
  notifications     Notification[]
  reports           Report[]

  @@map("conversations")
}

model ConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime         @default(now())
  isLeader       Boolean          @default(false)
  isAccepted     Boolean          @default(true)
  hiddenAt       DateTime?
  isArchived     Boolean          @default(false)
  markedUnreadAt DateTime?
  clearedAt      DateTime?
  origin         MembershipOrigin @default(INVITED)
  invitedById    String?
  rejectedAt     DateTime?
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model GroupInviteLink {
  id             String       @id @default(cuid())
  conversationId String       @unique
  token          String       @unique @default(cuid())
  createdById    String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("inviteLinkCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("group_invite_links")
}

model Message {
  id                  String              @id @default(cuid())
  conversationId      String
  senderId            String
  content             String?
  status              MessageStatus       @default(SENT)
  replyToId           String?
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  forwardedFromSender String?
  pinnedAt            DateTime?
  pinnedById          String?
  isSystemMessage     Boolean             @default(false)
  attachments         MessageAttachment[]
  reactions           MessageReaction[]
  conversation        Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pinnedBy            User?               @relation("pinnedMessages", fields: [pinnedById], references: [id])
  replyTo             Message?            @relation("replies", fields: [replyToId], references: [id])
  replies             Message[]           @relation("replies")
  sender              User                @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  reports             Report[]

  @@map("messages")
}

model MessageAttachment {
  id        String         @id @default(cuid())
  messageId String
  url       String
  key       String
  name      String
  size      Int
  type      AttachmentType
  mimeType  String?
  createdAt DateTime       @default(now())
  message   Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

model Notification {
  id               String           @id @default(cuid())
  recipientId      String
  actorId          String?
  type             NotificationType
  message          String?
  postId           String?
  commentId        String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  documentId       String?
  conversationId   String?
  supportRequestId String?
  actor            User?            @relation("actor", fields: [actorId], references: [id])
  conversation     Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipient        User             @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  iconUrl     String?
  color       String?
  posts       Post[]

  @@map("categories")
}

model Tag {
  id    String        @id @default(cuid())
  name  String        @unique
  slug  String        @unique
  posts TagsOnPosts[]

  @@map("tags")
}

model TagsOnPosts {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("tags_on_posts")
}

model Community {
  id          String            @id @default(cuid())
  ownerId     String
  name        String            @unique
  slug        String            @unique
  description String?
  avatarUrl   String?
  coverUrl    String?
  isPrivate   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("owner", fields: [ownerId], references: [id])
  members     CommunityMember[]
  posts       Post[]

  @@map("communities")
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  isAdmin     Boolean   @default(false)
  joinedAt    DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_members")
}

model Report {
  id             String        @id @default(cuid())
  reporterId     String
  reportedUserId String?
  postId         String?
  reason         ReportReason
  description    String?
  createdAt      DateTime      @default(now())
  commentId      String?
  messageId      String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  status         ReportStatus  @default(PENDING)
  documentId     String?
  conversationId String?
  comment        Comment?      @relation(fields: [commentId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  document       Document?     @relation(fields: [documentId], references: [id])
  message        Message?      @relation(fields: [messageId], references: [id])
  post           Post?         @relation(fields: [postId], references: [id])
  reportedUser   User?         @relation("reportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User          @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy     User?         @relation("reportResolver", fields: [resolvedById], references: [id])

  @@map("reports")
}

model ModerationAction {
  id                   String               @id @default(cuid())
  adminId              String
  targetUserId         String
  note                 String?
  notifiedUser         Boolean              @default(false)
  flaggedUser          Boolean              @default(false)
  postExcerpt          String?
  createdAt            DateTime             @default(now())
  suspendedUntil       DateTime?
  type                 ModerationActionType @default(POST_REMOVED)
  reason               SuspensionReason?
  targetConversationId String?
  admin                User                 @relation("moderationActor", fields: [adminId], references: [id], onDelete: Cascade)
  targetConversation   Conversation?        @relation(fields: [targetConversationId], references: [id])
  targetUser           User                 @relation("moderationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@map("moderation_actions")
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  documentId     String?
  attachmentId   String?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model AiSavedPrompt {
  id        String   @id @default(cuid())
  userId    String
  name      String
  template  String
  useCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_saved_prompts")
}

model AiDocumentSummary {
  id         String   @id @default(cuid())
  documentId String
  action     String
  language   Language
  content    String
  model      String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, action, language])
  @@map("ai_document_summaries")
}

model AiUsage {
  id    String @id @default(cuid())
  scope String
  day   String
  count Int    @default(0)

  @@unique([scope, day])
  @@map("ai_usage")
}

model AiExtractedText {
  id         String   @id @default(cuid())
  sourceType String
  sourceId   String
  text       String
  createdAt  DateTime @default(now())

  @@unique([sourceType, sourceId])
  @@map("ai_extracted_texts")
}

enum Role {
  USER
  ADMIN
}

enum DocumentType {
  PDF
  IMAGE
  VIDEO
  AUDIO
  LINK
  OTHER
  DOCX
  PPTX
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ModerationActionType {
  POST_REMOVED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_UNLOCKED
  GROUP_DISABLED
  GROUP_ENABLED
  GROUP_DELETED
  ACCOUNT_DELETION_SCHEDULED
  ACCOUNT_DELETION_CANCELLED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  MESSAGE
  SYSTEM
  REPLY
  FRIEND_REQUEST
  FRIEND_ACCEPT
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_REMOVED
  DOCUMENT_REPORTED
  POST_REMOVED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  ACCOUNT_UNLOCKED
  REPORT_SUBMITTED
  REPORT_RESOLVED
  REPORT_DISMISSED
  SUPPORT_REQUEST_SUBMITTED
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_JOIN_APPROVED
  GROUP_JOIN_REJECTED
  GROUP_DISABLED
  GROUP_ENABLED
  GROUP_DELETED
  GROUP_AUTO_DISBANDED
  SUPPORT_REQUEST_UPDATED
  ACCOUNT_DELETION_SCHEDULED
  ACCOUNT_DELETION_CANCELLED
}

enum MembershipOrigin {
  INVITED
  REQUESTED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum AttachmentType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PostVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum ReportReason {
  HATE_SPEECH
  SPAM
  SEXUAL_CONTENT
  VIOLENCE
  SCAM
  HARASSMENT
  OTHER
}

enum SuspensionReason {
  SPAM
  INAPPROPRIATE
  COPYRIGHT
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FriendRequestPermission {
  EVERYONE
  FRIENDS_OF_FRIENDS
  NOBODY
}

enum SupportRequestStatus {
  PENDING
  RESOLVED
  IN_PROGRESS
  WAITING_FOR_USER
  CLOSED
  REJECTED
}

enum SupportRequestType {
  ACCOUNT_SUPPORT
  BAN_APPEAL
  ACCOUNT_DELETION
  BUG_REPORT
  FEEDBACK
  OTHER
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Language {
  VI
  EN
}

enum AiMessageRole {
  USER
  ASSISTANT
}
